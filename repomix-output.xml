/* ==========================================================================
   HOJA DE ESTILOS GLOBAL - DELTA AIRLESS
   Índice:
   1. Variables globales
   2. Reset y estilos base
   3. Estilos compartidos (contenedores, botones, header, footer, hero de página)
   4. Página de inicio (index.html)
   5. Página de productos (productos.html)
   6. Página de servicios (servicios.html)
   7. Página de contacto (contacto.html)
   ========================================================================== */

/* ==========================================================================
   1. VARIABLES GLOBALES
   ========================================================================== */
:root {
  /* Colores corporativos */
  --color-delta-azul: #0a42aa;
  --color-delta-celeste: #3498db;
  --color-fondo-oscuro: #1c1c1c;
  --color-fondo-gris: #2d2d2d;
  --color-texto-blanco: #ffffff;
  --color-texto-gris: #b3b3b3;
  --color-acento-naranja: #f39c12;

  /* Colores de tarjetas, formularios y bordes */
  --color-tarjeta: #252525;
  --color-borde: #3a3a3a;

  /* Tipografía */
  --fuente-titulos: "Montserrat", "Arial Black", sans-serif;
  --fuente-cuerpo: "Roboto", "Arial", sans-serif;

  /* Espaciados */
  --espacio-pequeno: 10px;
  --espacio-mediano: 20px;
  --espacio-grande: 40px;

  /* Esquinas redondeadas */
  --radio-borde: 6px;
}

/* ==========================================================================
   2. RESET Y ESTILOS BASE (aplican a todas las páginas)
   ========================================================================== */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

iframe {
  max-width: 100%;
}

body {
  margin: 0;
  overflow-wrap: anywhere;
  font-family: var(--fuente-cuerpo);
  background-color: var(--color-fondo-oscuro);
  color: var(--color-texto-blanco);
  line-height: 1.6;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* ==========================================================================
   3. ESTILOS COMPARTIDOS ENTRE PÁGINAS
   ========================================================================== */

/* --------------------------------------------------------------------------
   3.1 Contenedores y secciones
   .contenedor centra y limita el ancho del contenido.
   .contenedor-estrecho reduce ese ancho (formulario y preguntas frecuentes).
   .seccion-pagina separa cada bloque; con .seccion-fondo-gris alterna el fondo.
   -------------------------------------------------------------------------- */
.contenedor {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

.contenedor-estrecho {
  max-width: 860px;
}

.seccion-pagina {
  padding: 60px 0;
}

.seccion-fondo-gris {
  background-color: var(--color-fondo-gris);
}

/* --------------------------------------------------------------------------
   3.2 Botones
   .btn-primario y .btn-secundario son reutilizables en todas las páginas.
   .grupo-botones los alinea en fila y anula el margin-top del botón primario.
   -------------------------------------------------------------------------- */
.btn-primario,
.btn-secundario {
  display: inline-block;
  padding: 12px 24px;
  font-family: var(--fuente-titulos);
  font-weight: 700;
  text-decoration: none;
  text-transform: uppercase;
  border-radius: 4px;
  transition: background-color 0.3s ease;
  border: none;
  cursor: pointer;
}

.btn-primario {
  background-color: var(--color-delta-azul);
  color: var(--color-texto-blanco);
  margin-top: 20px;
}

.btn-primario:hover,
.btn-primario:focus-visible {
  background-color: var(--color-delta-celeste);
}

.btn-secundario {
  background-color: transparent;
  border: 2px solid var(--color-delta-celeste);
  color: var(--color-delta-celeste);
}

.btn-secundario:hover {
  background-color: var(--color-delta-celeste);
  color: var(--color-texto-blanco);
}

.grupo-botones {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: var(--espacio-mediano);
}

.grupo-botones .btn-primario {
  margin-top: 0;
}

/* --------------------------------------------------------------------------
   3.3 Encabezado y navegación (header)
   Móvil primero: apilado. Desde 768px: logo a la izquierda y menú a la derecha.
   -------------------------------------------------------------------------- */
.header-principal {
  background-color: #111111;
  border-bottom: 2px solid var(--color-delta-azul);
  padding: 15px 0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-contenido {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.logo-marca {
  font-family: var(--fuente-titulos);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-texto-blanco);
  text-decoration: none;
}

.logo-marca span {
  color: var(--color-delta-celeste);
}

/* Menú con Flexbox: los enlaces bajan de línea si no caben */
.nav-menu {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  justify-content: center;
}

.nav-menu a {
  color: var(--color-texto-blanco);
  text-decoration: none;
  font-size: 0.95rem;
  padding: 5px 10px;
  border-bottom: 2px solid transparent;
  transition: color 0.3s;
}

.nav-menu a:hover,
.nav-menu a.activo {
  color: var(--color-delta-celeste);
  border-bottom: 2px solid var(--color-delta-celeste);
}

@media (min-width: 768px) {
  .header-contenido {
    flex-direction: row;
    justify-content: space-between;
  }
}

/* --------------------------------------------------------------------------
   3.4 Pie de página (footer)
   -------------------------------------------------------------------------- */
.footer-principal {
  background-color: #111111;
  border-top: 2px solid var(--color-delta-azul);
  padding: 30px 0;
  text-align: center;
  color: var(--color-texto-gris);
  font-size: 0.9rem;
}

.footer-principal a {
  color: var(--color-delta-celeste);
  text-decoration: none;
}

.footer-principal a:hover {
  text-decoration: underline;
}

/* --------------------------------------------------------------------------
   3.5 Título de sección
   <h2 class="titulo-seccion">Texto <span>resaltado</span></h2>
   El <span> se pinta de celeste.
   -------------------------------------------------------------------------- */
.titulo-seccion {
  margin-bottom: var(--espacio-mediano);
  font-family: var(--fuente-titulos);
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 800;
  text-transform: uppercase;
  line-height: 1.2;
  overflow-wrap: normal; /* el body usa "anywhere" y parte las palabras */
  hyphens: none;
}

.titulo-seccion span {
  color: var(--color-delta-celeste);
}

/* --------------------------------------------------------------------------
   3.6 Marco de imagen
   <figure class="marco-imagen"><img ...></figure>
   Mantiene una proporción 4:3 y recorta la imagen para llenar el marco.
   -------------------------------------------------------------------------- */
.marco-imagen {
  margin: 0;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background-color: var(--color-fondo-gris);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-borde);
}

.marco-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* --------------------------------------------------------------------------
   3.7 Hero de página (servicios y contacto)
   -------------------------------------------------------------------------- */
.hero-pagina {
  padding: 50px 0;
  background: linear-gradient(
    135deg,
    var(--color-fondo-oscuro) 0%,
    #0a1f4d 100%
  );
}

.hero-pagina .hero-contenido {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 30px;
  align-items: center;
}

.hero-etiqueta {
  display: inline-block;
  margin-bottom: 12px;
  padding: 4px 12px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-delta-celeste);
  border: 1px solid var(--color-delta-celeste);
  border-radius: 2px;
}

.hero-pagina h1 {
  font-family: var(--fuente-titulos);
  font-size: clamp(1.5rem, 7vw, 2.6rem);
  font-weight: 800;
  text-transform: uppercase;
  line-height: 1.15;
  overflow-wrap: normal;
  hyphens: none;
}

.hero-pagina h1 span {
  color: var(--color-delta-celeste);
}

.hero-descripcion {
  max-width: 55ch;
  margin-top: var(--espacio-mediano);
  font-size: 1.05rem;
  color: var(--color-texto-gris);
}

@media (min-width: 900px) {
  .hero-pagina {
    padding: 80px 0;
  }

  .hero-pagina h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
}

/* ==========================================================================
   4. PÁGINA DE INICIO (index.html)
   Todos los selectores usan el prefijo .inicio (clase del <body>).
   ========================================================================== */

/* --- 4.1 Hero --- */
.inicio .hero {
  background: linear-gradient(
    135deg,
    var(--color-fondo-oscuro) 0%,
    #0a1f4d 100%
  );
  padding: 80px 0;
}

.inicio .hero-contenido {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--espacio-grande);
  align-items: center;
}

.inicio .hero-texto {
  text-align: left;
}

.inicio .hero-etiqueta {
  display: inline-block;
  padding: 0;
  border: 0;
  background: none;
  color: var(--color-acento-naranja);
  font-weight: 500;
  font-size: 0.85rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: var(--espacio-pequeno);
}

.inicio .hero h1 {
  font-family: var(--fuente-titulos);
  font-size: clamp(2rem, 5vw, 3.2rem);
  line-height: 1.15;
  margin-bottom: var(--espacio-mediano);
}

.inicio .hero h1 span {
  color: var(--color-delta-celeste);
}

.inicio .hero p {
  color: var(--color-texto-gris);
  font-size: 1.1rem;
  max-width: 560px;
}

.inicio .hero-botones {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: var(--espacio-mediano);
}

.inicio .hero-botones .btn-primario {
  margin-top: 0;
}

.inicio .hero-imagen {
  width: 100%;
}

.inicio .hero-imagen img {
  width: 100%;
  max-width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 8px;
  border: 2px solid var(--color-delta-azul);
}
/* Anula las reglas de .hero de la sección 5 solo en inicio */
.inicio .hero {
  text-align: left;
}

.inicio .hero .hero-contenido {
  display: grid;
  grid-template-columns: 1fr;
  align-items: stretch;
  text-align: left;
}

.inicio .hero .hero-texto p {
  margin: 0;
  text-align: left;
}

@media (min-width: 768px) {
  .inicio .hero .hero-contenido {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
  }
}

/* --- 4.2 Estadísticas --- */
.inicio .estadisticas {
  background-color: var(--color-delta-azul);
  padding: 40px 0;
}

.inicio .grid-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--espacio-mediano);
  text-align: center;
}

.inicio .stat strong {
  display: block;
  font-family: var(--fuente-titulos);
  font-size: 1.8rem;
}

.inicio .stat span {
  font-size: 0.9rem;
  opacity: 0.9;
}

/* --- 4.3 Secciones genéricas y títulos --- */
.inicio .seccion {
  padding: 70px 0;
}

.inicio .seccion-gris {
  background-color: var(--color-fondo-gris);
}

.inicio .seccion-titulo {
  font-family: var(--fuente-titulos);
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  text-align: center;
  margin-bottom: 10px;
}

.inicio .seccion-subtitulo {
  text-align: center;
  color: var(--color-texto-gris);
  max-width: 620px;
  margin: 0 auto var(--espacio-grande);
}

.inicio .centrar {
  text-align: center;
  margin-top: var(--espacio-grande);
}

/* --- 4.4 Tarjetas de ventajas --- */
.inicio .grid-tarjetas {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--espacio-mediano);
}

.inicio .tarjeta {
  background-color: var(--color-fondo-oscuro);
  border: 1px solid var(--color-borde);
  border-top: 3px solid var(--color-delta-azul);
  border-radius: 6px;
  padding: 28px 24px;
  transition:
    transform 0.3s ease,
    border-color 0.3s ease;
}

.inicio .tarjeta:hover {
  transform: translateY(-5px);
  border-top-color: var(--color-delta-celeste);
}

.inicio .tarjeta .icono {
  font-size: 2rem;
  margin-bottom: 12px;
}

.inicio .tarjeta h3 {
  font-family: var(--fuente-titulos);
  font-size: 1.1rem;
  margin-bottom: 8px;
}

.inicio .tarjeta p {
  color: var(--color-texto-gris);
  font-size: 0.95rem;
}

/* --- 4.5 Pasos (lista ordenada con contador CSS) --- */
.inicio .pasos {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--espacio-mediano);
  counter-reset: paso;
}

.inicio .pasos li {
  counter-increment: paso;
  background-color: var(--color-fondo-gris);
  border-radius: 6px;
  padding: 24px;
  position: relative;
}

.inicio .pasos li::before {
  content: counter(paso);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  background-color: var(--color-delta-celeste);
  border-radius: 50%;
  font-family: var(--fuente-titulos);
  margin-bottom: 10px;
}

.inicio .pasos h3 {
  font-family: var(--fuente-titulos);
  font-size: 1.05rem;
  margin-bottom: 6px;
}

.inicio .pasos p {
  color: var(--color-texto-gris);
  font-size: 0.95rem;
}

/* --- 4.6 Videos de Instagram --- */
.inicio .grid-videos {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  align-items: start;
}

.inicio .grid-videos .video-card {
  min-width: 0;
}

.inicio .video-card {
  background-color: var(--color-fondo-gris);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  justify-content: center;
}

.inicio .video-card iframe {
  width: 100%;
  height: 620px;
  border: 0;
}

/* --- 4.7 Testimonios --- */
.inicio .grid-testimonios {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--espacio-mediano);
}

.inicio .testimonio {
  background-color: var(--color-fondo-oscuro);
  border-left: 4px solid var(--color-acento-naranja);
  border-radius: 6px;
  padding: 24px;
}

.inicio .testimonio .estrellas {
  color: var(--color-acento-naranja);
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.inicio .testimonio p {
  font-style: italic;
  margin-bottom: 12px;
}

.inicio .testimonio cite {
  color: var(--color-delta-celeste);
  font-style: normal;
  font-weight: 500;
  font-size: 0.9rem;
}

/* --- 4.8 Llamada a la acción final --- */
.inicio .cta-final {
  text-align: center;
  background: linear-gradient(135deg, #0a1f4d, var(--color-delta-azul));
  padding: 70px 0;
}

.inicio .cta-final h2 {
  font-family: var(--fuente-titulos);
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  margin-bottom: 12px;
}

.inicio .cta-final p {
  max-width: 560px;
  margin: 0 auto 10px;
  opacity: 0.9;
}

/* --- 4.9 Adaptación a escritorio (768px) --- */
@media (min-width: 768px) {
  .inicio .hero-contenido {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .inicio .grid-tarjetas {
    grid-template-columns: repeat(3, 1fr);
  }

  .inicio .grid-stats {
    grid-template-columns: repeat(4, 1fr);
  }

  .inicio .pasos {
    grid-template-columns: repeat(3, 1fr);
  }

  .inicio .grid-videos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ==========================================================================
   5. PÁGINA DE PRODUCTOS (productos.html)
   ========================================================================== */

/* --- 5.1 Hero de introducción --- */
.hero {
  background: linear-gradient(
    135deg,
    var(--color-fondo-oscuro) 0%,
    #0a1f4d 100%
  );
  padding: 80px 0;
  text-align: center;
}

.hero .contenedor {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-productos h1 {
  font-family: var(--fuente-titulos);
  font-size: clamp(2rem, 4.5vw, 3rem);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 20px;
  max-width: 900px;
  color: var(--color-texto-blanco);
  text-align: center;
  margin-left: auto;
  margin-right: auto;
}

/* El <span> del título se pinta de celeste */
.hero-productos h1 span {
  color: var(--color-delta-celeste);
}

.hero p {
  color: var(--color-texto-gris);
  font-size: 1.05rem;
  max-width: 750px;
  margin: 0 auto;
  line-height: 1.6;
  text-align: center;
}

/* --- 5.2 Catálogo de productos --- */
#catalogo {
  padding: 60px 0;
}

.grid-productos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: var(--espacio-mediano);
  margin-top: var(--espacio-mediano);
}

.card-producto {
  background-color: var(--color-tarjeta);
  border: 1px solid var(--color-borde);
  border-top: 4px solid var(--color-delta-celeste);
  border-radius: var(--radio-borde);
  padding: 24px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
  transition:
    transform 0.3s ease,
    border-color 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-producto:hover {
  transform: translateY(-5px);
  border-color: var(--color-delta-azul);
}

.card-producto h3 {
  font-family: var(--fuente-titulos);
  font-size: 1.2rem;
  color: var(--color-texto-blanco);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--color-borde);
}

.card-producto ul {
  list-style: none;
  margin-bottom: 16px;
}

.card-producto ul li {
  font-size: 0.92rem;
  padding: 5px 0;
  border-bottom: 1px dashed var(--color-borde);
  color: var(--color-texto-gris);
}

.card-producto ul li:last-child {
  border-bottom: none;
}

.card-producto ul li strong {
  color: var(--color-texto-blanco);
}

.tipos-pintura {
  font-size: 0.88rem;
  background-color: rgba(52, 152, 219, 0.1);
  color: var(--color-delta-celeste);
  padding: 10px;
  border-radius: 4px;
  border-left: 3px solid var(--color-delta-celeste);
  margin-top: auto;
}

/* Altura fija para que todas las tarjetas tengan la misma medida */
.imagen-producto {
  width: 100%;
  height: 200px;
  background-color: #1a1a1a;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-borde);
}

/* object-fit: contain mantiene la proporción de la máquina sin recortarla */
.imagen-producto img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

/* Zoom sutil al pasar el cursor sobre la tarjeta */
.card-producto:hover .imagen-producto img {
  transform: scale(1.05);
}

/* --- 5.3 Ventajas de las máquinas --- */
#ventajas {
  background-color: var(--color-fondo-gris);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio-borde);
  padding: 40px;
  margin: 40px auto;
}

#ventajas h2 {
  font-family: var(--fuente-titulos);
  font-size: 1.5rem;
  color: var(--color-texto-blanco);
  margin-bottom: 16px;
  text-align: center;
}

#ventajas ul {
  list-style: disc;
  padding-left: 20px;
  max-width: 900px;
  margin: 0 auto;
}

#ventajas ul li {
  margin-bottom: 10px;
  font-size: 1rem;
  color: var(--color-texto-gris);
}

/* ==========================================================================
   6. PÁGINA DE SERVICIOS (servicios.html)
   ========================================================================== */

/* --------------------------------------------------------------------------
   6.1 Respaldo (<section class="seccion-respaldo">)
   Cuatro tarjetas centradas con ícono, título y descripción.
   Móvil: 1 columna | 560px: 2 columnas | 1000px: 4 columnas
   -------------------------------------------------------------------------- */
.seccion-respaldo {
  padding: 40px 0;
  background-color: #151515;
}

.lista-respaldo {
  list-style: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
}

.tarjeta-respaldo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28px 18px;
  text-align: center;
  background-color: var(--color-tarjeta);
  border: 1px solid var(--color-borde);
  border-bottom: 3px solid var(--color-delta-azul);
  border-radius: var(--radio-borde);
  transition:
    transform 0.3s ease,
    border-bottom-color 0.3s ease;
}

.tarjeta-respaldo:hover {
  transform: translateY(-4px);
  border-bottom-color: var(--color-delta-celeste);
}

.titulo-respaldo {
  font-family: var(--fuente-titulos);
  font-size: 1.15rem;
  text-transform: uppercase;
  overflow-wrap: normal;
}

.texto-respaldo {
  max-width: 24ch;
  margin-top: 8px;
  font-size: 0.9rem;
  color: var(--color-texto-gris);
}

@media (min-width: 560px) {
  .lista-respaldo {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (min-width: 1000px) {
  .lista-respaldo {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}


/* --------------------------------------------------------------------------
   6.2 Frecuencia de mantenimiento (<section id="frecuencia">)
   Tarjetas Diario / Semanal / Mensual / Anual: siempre de dos en dos (2x2).
   -------------------------------------------------------------------------- */
.texto-introduccion {
  max-width: 62ch;
  margin-bottom: var(--espacio-grande);
  color: var(--color-texto-gris);
}

.grid-mantenimiento {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.tarjeta-mantenimiento {
  padding: 18px 14px;
  background-color: var(--color-tarjeta);
  border-top: 4px solid var(--color-delta-celeste);
  border-radius: var(--radio-borde);
  transition: transform 0.3s ease;
}

.tarjeta-mantenimiento:hover {
  transform: translateY(-4px);
}

/* Número decorativo de cada frecuencia (01 a 04) */
.numero-frecuencia {
  display: block;
  font-family: var(--fuente-titulos);
  font-size: 1.8rem;
  font-weight: 800;
  line-height: 1;
  color: var(--color-delta-azul);
}

.tarjeta-mantenimiento h3 {
  margin: 8px 0;
  font-family: var(--fuente-titulos);
  font-size: 1.05rem;
  text-transform: uppercase;
}

.tarjeta-mantenimiento p {
  font-size: 0.9rem;
  color: var(--color-texto-gris);
}

@media (min-width: 768px) {
  .grid-mantenimiento {
    gap: var(--espacio-mediano);
  }

  .tarjeta-mantenimiento {
    padding: 28px 24px;
  }

  .numero-frecuencia {
    font-size: 2.4rem;
  }

  .tarjeta-mantenimiento h3 {
    font-size: 1.25rem;
  }

  .tarjeta-mantenimiento p {
    font-size: 1rem;
  }
}

/* --------------------------------------------------------------------------
   6.3 Información técnica (<article class="info-bloque">)
   Imagen + texto. Con .info-bloque-invertido la imagen pasa a la derecha.
   Móvil: apilado | 900px: dos columnas
   -------------------------------------------------------------------------- */
.info-bloque {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 24px;
  align-items: center;
  margin-top: var(--espacio-grande);
}

.info-bloque h3 {
  margin-bottom: 10px;
  font-family: var(--fuente-titulos);
  font-size: 1.5rem;
  text-transform: uppercase;
  color: var(--color-delta-celeste);
  overflow-wrap: normal;
}

.info-bloque p {
  color: var(--color-texto-gris);
}

/* Lista con viñeta ">" naranja: el símbolo se agrega con ::before en cada <li> */
.lista-beneficios {
  list-style: none;
  margin-top: 16px;
}

.lista-beneficios li {
  position: relative;
  padding: 4px 0 4px 24px;
}

.lista-beneficios li::before {
  content: ">";
  position: absolute;
  left: 4px;
  font-weight: 700;
  color: var(--color-acento-naranja);
}

@media (min-width: 900px) {
  .info-bloque {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 50px;
  }

  /* Imagen a la derecha */
  .info-bloque-invertido .marco-imagen {
    order: 2;
  }
}

/* --------------------------------------------------------------------------
   6.4 Llamado a la acción (<section class="seccion-llamado-accion">)
   Banda final con degradado azul y botón hacia contacto.html.
   -------------------------------------------------------------------------- */
.seccion-llamado-accion {
  padding: 70px 0;
  text-align: center;
  background: linear-gradient(
    135deg,
    #0a1f4d,
    var(--color-delta-azul)
  ); /* igual que .cta-final del inicio */
}

.seccion-llamado-accion h2 {
  font-family: var(--fuente-titulos);
  font-size: clamp(1.5rem, 5vw, 2.4rem);
  font-weight: 800;
  text-transform: uppercase;
  overflow-wrap: normal;
}

.seccion-llamado-accion h2 span {
  color: var(--color-delta-celeste);
}

.seccion-llamado-accion p {
  max-width: 60ch;
  margin: 14px auto 0;
  color: #dddddd;
}

/* ==========================================================================
   7. PÁGINA DE CONTACTO (contacto.html)
   Orden igual que en la página: 7.1 Formulario | 7.2 Preguntas frecuentes
   ========================================================================== */

/* --------------------------------------------------------------------------
   7.1 Formulario (<form class="formulario-contacto">)
   Tarjeta con grupos <fieldset>. La validación es solo HTML (sin JavaScript).
   -------------------------------------------------------------------------- */
.formulario-contacto {
  padding: 28px 20px;
  background-color: var(--color-tarjeta);
  border-top: 4px solid var(--color-delta-celeste);
  border-radius: var(--radio-borde);
}

/* Grupo de campos con borde y título (<fieldset><legend>) */
.formulario-contacto fieldset {
  min-width: 0; /* evita desbordes en móvil */
  margin: 20px 0;
  padding: 18px 16px 4px;
  border: 1px solid var(--color-borde);
  border-radius: 4px;
}

.formulario-contacto legend {
  padding: 0 10px;
  font-family: var(--fuente-titulos);
  font-size: 0.9rem;
  text-transform: uppercase;
  color: var(--color-delta-celeste);
}

/* .fila-campos junta dos campos: apilados en móvil, lado a lado desde 600px */
.fila-campos {
  display: grid;
  gap: 0 16px;
}

/* .campo-formulario = etiqueta + control, uno bajo el otro */
.campo-formulario {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.campo-formulario label,
.etiqueta-grupo-opciones {
  font-size: 0.9rem;
  font-weight: 500;
}

/* Controles de texto. Se excluyen radios y checkbox porque tienen su propio estilo */
.formulario-contacto input:not([type="radio"]):not([type="checkbox"]),
.formulario-contacto select,
.formulario-contacto textarea {
  width: 100%;
  padding: 12px;
  font-family: inherit;
  font-size: 1rem;
  color: var(--color-texto-blanco);
  background-color: var(--color-fondo-oscuro);
  border: 1px solid #555555;
  border-radius: 4px;
  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.formulario-contacto textarea {
  min-height: 120px;
  resize: vertical;
}

.formulario-contacto ::placeholder {
  color: #777777;
}

/* Foco con teclado: borde celeste */
.formulario-contacto :focus-visible {
  outline: none;
  border-color: var(--color-delta-celeste);
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
}

/* Validación nativa de HTML: rojo si el dato es incorrecto, verde si es correcto */
.formulario-contacto :user-invalid {
  border-color: #e74c3c;
}

.formulario-contacto :user-valid {
  border-color: #2ecc71;
}

/* Radios y checkbox */
.grupo-opciones {
  display: grid;
  gap: 10px;
  margin-top: 4px;
}

.opcion-seleccionable {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.opcion-seleccionable input {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  accent-color: var(--color-delta-celeste);
}

.opcion-consentimiento {
  align-items: flex-start;
  margin-bottom: var(--espacio-mediano);
  font-size: 0.9rem;
  color: var(--color-texto-gris);
}

/* Marca de campo obligatorio */
.asterisco-obligatorio {
  color: var(--color-acento-naranja);
}

.texto-ayuda {
  font-size: 0.85rem;
  color: var(--color-texto-gris);
}

/* Botones Enviar y Limpiar: se reparten el ancho de la fila */
.formulario-contacto .grupo-botones > * {
  flex: 1 1 160px;
  text-align: center;
}

@media (min-width: 600px) {
  .fila-campos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .formulario-contacto {
    padding: 36px 32px;
  }
}

/* --------------------------------------------------------------------------
   7.2 Preguntas frecuentes (<article class="pregunta-frecuente">)
   Siempre visibles: pregunta (h3) y respuesta (p) una debajo de la otra.
   -------------------------------------------------------------------------- */
.pregunta-frecuente {
  margin-bottom: 12px;
  padding: 18px 20px;
  background-color: var(--color-tarjeta);
  border-left: 4px solid var(--color-delta-celeste);
  border-radius: var(--radio-borde);
}

.pregunta-frecuente h3 {
  margin-bottom: 6px;
  font-size: 1.05rem;
  overflow-wrap: normal;
}

.pregunta-frecuente p {
  color: var(--color-texto-gris);
}

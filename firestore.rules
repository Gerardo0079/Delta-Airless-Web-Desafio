
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{userId} {
      allow read: if autenticado()
        && (request.auth.uid == userId || esAdmin());

      // Al registrarse, el rol SOLO puede ser 'cliente'
      allow create: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.rol == 'cliente';

      // Puede editar su perfil, pero nunca cambiar su rol
      allow update: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.rol == resource.data.rol;

      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    match /solicitudes/{solicitudId} {

      // El cliente solo crea solicitudes a su nombre,
      // en estado Pendiente y sin respuesta administrativa.
      allow create: if autenticado()
        && request.resource.data.uidCliente == request.auth.uid
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.respuestaAdmin == ''
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1
        && request.resource.data.cantidad <= 50;

      // Cliente: solamente lee sus solicitudes.
      // Administrador: puede leer todas.
      allow read: if autenticado()
        && (
          resource.data.uidCliente == request.auth.uid
          || esAdmin()
        );

      // Administrador: actualiza estado y respuesta técnica.
      // Cliente: solo cancela una solicitud propia Pendiente.
      allow update: if (
          esAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['estado', 'respuestaAdmin'])
          && request.resource.data.estado in [
            'Pendiente',
            'En revisión',
            'Aprobada',
            'Finalizada',
            'Cancelada'
          ]
          && request.resource.data.respuestaAdmin is string
          && (
            !(request.resource.data.estado in ['Aprobada', 'Finalizada'])
            || request.resource.data.respuestaAdmin.size() > 0
          )
        )
        || (
          autenticado()
          && resource.data.uidCliente == request.auth.uid
          && resource.data.estado == 'Pendiente'
          && request.resource.data.estado == 'Cancelada'
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['estado'])
        );

      allow delete: if esAdmin();
    }
  }
}
